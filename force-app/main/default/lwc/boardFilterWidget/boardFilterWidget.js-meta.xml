<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Board: Filter Bar</masterLabel>
    <description>Declarative filter bar widget for Board component library</description>
    <targets>
        <target>lightning__FlowScreen</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen" configurationEditor="c-board-filter-cpe">
            <property name="boardId" type="String" label="Board ID" default="default" />
            <property name="title" type="String" label="Title" />
            <property name="recordId" type="String" label="Record ID" role="inputOnly" />
            <property name="filterContextJson" type="String" label="Filter Context JSON" />
            <property name="configJson" type="String" label="Configuration JSON" />
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage">
            <property name="boardId" type="String" label="Board ID" default="default" />
            <property name="title" type="String" label="Title" />
            <property name="recordId" type="String" label="Record ID" />
            <property name="filterContextJson" type="String" label="Filter Context JSON" />
            <property name="configJson" type="String" label="Configuration JSON" />
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>