<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Proto Board Widget (PROTOTYPE)</masterLabel>
    <description>Throwaway prototype Widget (metric, bar, table) reacting to Board filter context</description>
    <targets>
        <target>lightning__FlowScreen</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen" configurationEditor="c-proto-widget-cpe">
            <property name="title" type="String" label="Widget Title" default="Pipeline Metric"/>
            <property name="widgetType" type="String" label="Widget Type (metric, bar, table)" default="metric"/>
            <property name="boardId" type="String" label="Board ID" default="default"/>
            <property name="recordId" type="String" label="Record ID" role="inputOnly"/>
            <property name="filterContextJson" type="String" label="Filter Context JSON (Reactive Input)"/>
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage">
            <property name="title" type="String" label="Widget Title" default="Pipeline Metric"/>
            <property name="widgetType" type="String" label="Widget Type" datasource="metric,bar,table" default="metric"/>
            <property name="boardId" type="String" label="Board ID" default="default"/>
            <supportedFormFactors>
                <supportedFormFactor type="Large"/>
                <supportedFormFactor type="Small"/>
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>